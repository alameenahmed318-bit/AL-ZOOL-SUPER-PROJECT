<Window x:Class="ALZOOOOL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AL-ZOOL SUPER AI" Height="900" Width="1500"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#0A100D" Foreground="#F4F1E8"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <SolidColorBrush x:Key="Gold" Color="#D9B65D"/>
        <SolidColorBrush x:Key="Green" Color="#236B49"/>
        <SolidColorBrush x:Key="Panel" Color="#151F19"/>
        <SolidColorBrush x:Key="Panel2" Color="#1B2921"/>
        <SolidColorBrush x:Key="Muted" Color="#A8B7AC"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F2E9"/>
            <Setter Property="Background" Value="#203D2C"/>
            <Setter Property="BorderBrush" Value="#355B43"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B573C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D9B65D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111C15" CornerRadius="18"
                BorderBrush="#2B4935" BorderThickness="1" Padding="13">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="5,5,5,16">
                    <Border Background="#1B3022" BorderBrush="#725D2E" BorderThickness="1"
                            CornerRadius="14" Padding="13">
                        <StackPanel>
                            <TextBlock Text="AZ | الزول" Foreground="{StaticResource Gold}"
                                       FontSize="27" FontWeight="Bold"/>
                            <TextBlock Text="AL-ZOOL SUPER AI" Foreground="#F4F1E8"
                                       FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="GOLD • XAUUSD" Foreground="#AFC2B2"
                                       FontSize="10" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="لوحة القيادة" Foreground="{StaticResource Gold}"
                               FontSize="12" FontWeight="Bold" Margin="5,18,5,7"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="الرئيسية" Tag="الرئيسية" Click="Navigate_Click"/>
                        <Button Content="عقل الذكاء الاصطناعي" Tag="عقل الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Content="تحليل السوق" Tag="تحليل السوق" Click="Navigate_Click"/>
                        <Button Content="مكتبة الاستراتيجيات" Tag="مكتبة الاستراتيجيات" Click="Navigate_Click"/>
                        <Button Content="مختبر الاستراتيجيات والتركيبات" Tag="مختبر الاستراتيجيات والتركيبات" Click="Navigate_Click"/>
                        <Button Content="قرارات الذكاء الاصطناعي" Tag="قرارات الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Content="الصفقات المفتوحة" Tag="الصفقات المفتوحة" Click="Navigate_Click"/>
                        <Button Content="إدارة المخاطر" Tag="إدارة المخاطر" Click="Navigate_Click"/>
                        <Button Content="الإعدادات الثابتة" Tag="الإعدادات الثابتة" Click="Navigate_Click"/>
                        <Button Content="اللوت والتعزيز والتبريد" Tag="اللوت والتعزيز والتبريد" Click="Navigate_Click"/>
                        <Button Content="الأداء والإحصائيات" Tag="الأداء والإحصائيات" Click="Navigate_Click"/>
                        <Button Content="ذاكرة الذكاء الاصطناعي" Tag="ذاكرة الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Content="مراقبة النظام والاتصال" Tag="مراقبة النظام والاتصال" Click="Navigate_Click"/>
                        <Button Content="مركز الطوارئ" Tag="مركز الطوارئ" Click="Navigate_Click"/>
                        <Button Content="الأخبار الاقتصادية" Tag="الأخبار الاقتصادية" Click="Navigate_Click"/>
                        <Button Content="سجل التداول" Tag="سجل التداول" Click="Navigate_Click"/>
                        <Button Content="التنبيهات" Tag="التنبيهات" Click="Navigate_Click"/>
                        <Button Content="إعدادات الذكاء الاصطناعي" Tag="إعدادات الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Content="ماذا لو؟ محاكاة السوق" Tag="ماذا لو؟ محاكاة السوق" Click="Navigate_Click"/>
                        <Button Content="خريطة السيولة" Tag="خريطة السيولة" Click="Navigate_Click"/>
                        <Button Content="توقع حركة الذهب" Tag="توقع حركة الذهب" Click="Navigate_Click"/>
                        <Button Content="مقارنة الصفقات" Tag="مقارنة الصفقات" Click="Navigate_Click"/>
                        <Button Content="منافسة الاستراتيجيات" Tag="منافسة الاستراتيجيات" Click="Navigate_Click"/>
                        <Button Content="سجل التداول التحليلي" Tag="سجل التداول التحليلي" Click="Navigate_Click"/>
                        <Button Content="المساعد الصوتي العربي" Tag="المساعد الصوتي العربي" Click="Navigate_Click"/>
                        <Button Content="مركز التحكم الرئيسي" Tag="مركز التحكم الرئيسي" Click="Navigate_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#151F19" CornerRadius="16"
                    BorderBrush="#2C4936" BorderThickness="1" Padding="17" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right">
                        <TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="25"
                                   FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                        <TextBlock x:Name="PageDescription" Text="مركز مراقبة الذهب وإدارة التداول"
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#202F25" CornerRadius="9" Padding="12,9" Margin="0,0,9,0">
                            <TextBlock x:Name="ConnectionStatus" Text="غير متصل"
                                       Foreground="OrangeRed" FontWeight="Bold"/>
                        </Border>
                        <Button x:Name="ConnectButton" Content="تحديث اتصال MT5"
                                Click="ConnectButton_Click" Background="{StaticResource Gold}"
                                Foreground="#172017" BorderBrush="{StaticResource Gold}"
                                Padding="16,11"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                <Border Background="{StaticResource Panel}" BorderBrush="#2A4433" BorderThickness="1"
                        CornerRadius="13" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="حالة التداول" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock x:Name="TradingStatus" Text="متوقف" FontSize="23"
                                   FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" BorderBrush="#2A4433" BorderThickness="1"
                        CornerRadius="13" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="الأداة المالية" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="XAUUSD  |  GOLD" FontSize="21"
                                   FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" BorderBrush="#2A4433" BorderThickness="1"
                        CornerRadius="13" Padding="16">
                    <StackPanel>
                        <TextBlock Text="وضع النظام" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="مراقبة وتحليل MT5" FontSize="19"
                                   FontWeight="Bold" Foreground="#A9D2B0" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="#17251B" BorderBrush="#735E31" BorderThickness="1"
                    CornerRadius="15" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="مركز التحكم بالتداول" Foreground="{StaticResource Gold}"
                                   FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="التشغيل الآلي غير متاح حتى اكتمال ربط أوامر MT5 واختبار الحماية على حساب تجريبي."
                                   Foreground="#D8C995" FontSize="12" Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Button x:Name="StartButton" Content="▶ تشغيل التداول الآلي"
                                Click="StartButton_Click" Width="190" Height="46"
                                Background="#236B49" BorderBrush="#4A9468" Margin="0,0,8,0"/>
                        <Button x:Name="StopButton" Content="■ إيقاف التداول"
                                Click="StopButton_Click" Width="155" Height="46"
                                Background="#783F37" BorderBrush="#A75B4D"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="16"
                    BorderBrush="#2C4936" BorderThickness="1" Padding="18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="مراقبة السوق والاتصال" Foreground="{StaticResource Gold}"
                                   FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="بيانات الحساب والتحليل تظهر هنا عند وصولها من جسر MT5."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#0E1711" BorderBrush="#2B4634" BorderThickness="1"
                                    CornerRadius="11" Padding="17" Margin="0,0,0,14">
                                <TextBlock x:Name="SectionInfo" Text="بانتظار بيانات MT5..."
                                           FontSize="15" TextWrapping="Wrap" Foreground="#F3F0E7"/>
                            </Border>
                            <TextBlock Text="تفاصيل القسم" Foreground="{StaticResource Gold}"
                                       FontSize="16" FontWeight="Bold" Margin="0,2,0,9"/>
                            <StackPanel x:Name="PageContent"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>