<Window x:Class="ALZOOOOL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AL-ZOOL FUTURE TERMINAL" Width="1440" Height="900"
        MinWidth="980" MinHeight="620" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="#F1F2F7"
        Foreground="#252438" FlowDirection="RightToLeft"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#7657F6"/>
        <SolidColorBrush x:Key="AccentDark" Color="#5635D8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EEEAFE"/>
        <SolidColorBrush x:Key="Canvas" Color="#F1F2F7"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#F7F7FB"/>
        <SolidColorBrush x:Key="Stroke" Color="#E5E5EF"/>
        <SolidColorBrush x:Key="Ink" Color="#252438"/>
        <SolidColorBrush x:Key="Muted" Color="#85849A"/>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#7657F6"/>
            <Setter Property="BorderBrush" Value="#7657F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5F5E73"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="13"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#85849A"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Canvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4E4ED"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="12,14,12,12">
                <StackPanel DockPanel.Dock="Top">
                    <Border CornerRadius="13" Padding="12" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#292343" Offset="0"/>
                                <GradientStop Color="#6448D9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="10" Background="#FFFFFF"
                                    VerticalAlignment="Center">
                                <Viewbox Margin="8">
                                    <Path Data="M 2,15 L 12,2 L 22,15 L 12,28 Z M 12,8 L 17,15 L 12,22 L 7,15 Z"
                                          Fill="#7657F6" Stretch="Uniform"/>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AL-ZOOL" Foreground="White" FontSize="15"
                                           FontWeight="ExtraBold"/>
                                <TextBlock Text="FUTURE TERMINAL" Foreground="#D9D2FF"
                                           FontSize="8.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="WORKSPACE" Foreground="#A09FB0" FontSize="9"
                               FontWeight="Bold" Margin="7,0,0,7"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="1,10,1,0">
                    <Border Background="#F5F4FB" CornerRadius="9" Padding="10">
                        <StackPanel>
                            <TextBlock Text="MT5 CONNECTION" Foreground="#9291A4" FontSize="8"/>
                            <TextBlock Text="●  LIVE LINK STATUS" Foreground="#7657F6"
                                       FontSize="9.5" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="VERSION  •  2026" Foreground="#AAA9B8"
                               FontSize="8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Style="{StaticResource NavButton}" Content="◈   الرئيسية" Tag="الرئيسية" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="✧   عقل الذكاء الاصطناعي" Tag="عقل الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌁   تحليل السوق" Tag="تحليل السوق" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▤   مكتبة الاستراتيجيات" Tag="مكتبة الاستراتيجيات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▦   مختبر الاستراتيجيات والتركيبات" Tag="مختبر الاستراتيجيات والتركيبات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◉   قرارات الذكاء الاصطناعي" Tag="قرارات الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⇄   الصفقات المفتوحة" Tag="الصفقات المفتوحة" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⬡   إدارة المخاطر" Tag="إدارة المخاطر" Click="Navigate_Click"/>
                        <TextBlock Text="SYSTEM" Foreground="#A09FB0" FontSize="9"
                                   FontWeight="Bold" Margin="7,14,0,6"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙   الإعدادات الثابتة" Tag="الإعدادات الثابتة" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="↗   اللوت والتعزيز والتبريد" Tag="اللوت والتعزيز والتبريد" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▥   الأداء والإحصائيات" Tag="الأداء والإحصائيات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◌   ذاكرة الذكاء الاصطناعي" Tag="ذاكرة الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌘   مراقبة النظام والاتصال" Tag="مراقبة النظام والاتصال" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚠   مركز الطوارئ" Tag="مركز الطوارئ" Click="Navigate_Click"/>
                        <TextBlock Text="ADVANCED TOOLS" Foreground="#A09FB0" FontSize="9"
                                   FontWeight="Bold" Margin="7,14,0,6"/>
                        <Button Style="{StaticResource NavButton}" Content="◷   الأخبار الاقتصادية" Tag="الأخبار الاقتصادية" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="☷   سجل التداول" Tag="سجل التداول" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="♧   التنبيهات" Tag="التنبيهات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="✦   إعدادات الذكاء الاصطناعي" Tag="إعدادات الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◇   ماذا لو؟ محاكاة السوق" Tag="ماذا لو؟ محاكاة السوق" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌖   خريطة السيولة" Tag="خريطة السيولة" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌁   توقع حركة الذهب" Tag="توقع حركة الذهب" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⇆   مقارنة الصفقات" Tag="مقارنة الصفقات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="♜   منافسة الاستراتيجيات" Tag="منافسة الاستراتيجيات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▧   سجل التداول التحليلي" Tag="سجل التداول التحليلي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◖   المساعد الصوتي العربي" Tag="المساعد الصوتي العربي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="☷   مركز التحكم الرئيسي" Tag="مركز التحكم الرئيسي" Click="Navigate_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Full-size page host -->
        <Grid Grid.Column="1" Margin="20,14,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="1,0,1,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="21"
                               FontWeight="Bold" Foreground="#252438"/>
                    <TextBlock x:Name="PageDescription" Text="منصة ذكية لمراقبة وتحليل الذهب"
                               Foreground="#85849A" FontSize="10.5" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFFFF" BorderBrush="#E5E5EF" BorderThickness="1"
                            CornerRadius="8" Padding="10,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#D58A56" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ConnectionStatus" Text="غير متصل"
                                       Foreground="#625F78" FontSize="10.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ConnectButton" Content="اتصال MT5  ↗"
                            Click="ConnectButton_Click" Padding="14,9" FontSize="10.5"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E5EF"
                    BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="5" Height="27" Background="#7657F6" CornerRadius="3" Margin="0,0,9,0"/>
                        <StackPanel>
                            <TextBlock Text="TRADE CONTROL" Foreground="#8A889E"
                                       FontSize="8" FontWeight="Bold"/>
                            <TextBlock Text="مركز التحكم بالتداول" Foreground="#29273E"
                                       FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TradingStatus" Text="متوقف" Foreground="#7657F6"
                                   FontSize="10" FontWeight="Bold" Margin="16,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Content="▶ تشغيل التداول"
                                Click="StartButton_Click" Width="132" Padding="9,7"
                                Margin="0,0,7,0" FontSize="10"/>
                        <Button x:Name="StopButton" Content="■ إيقاف"
                                Click="StopButton_Click" Width="90" Padding="9,7"
                                Background="#F4F1F8" BorderBrush="#E3DDF2"
                                Foreground="#655B83" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E5EF"
                        BorderThickness="1" CornerRadius="10" Padding="11,8" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#F0EDFF" CornerRadius="7" Padding="8,5" Margin="0,0,9,0">
                            <TextBlock Text="LIVE DATA" Foreground="#7657F6"
                                       FontSize="8" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="SectionInfo" Grid.Column="1"
                                   Text="بانتظار بيانات MT5..." Foreground="#69677D"
                                   FontSize="10.5" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E5EF"
                        BorderThickness="1" CornerRadius="11" Padding="14">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="مساحة العمل" Foreground="#29273E"
                                       FontSize="12" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="FULL PAGE VIEW"
                                       Foreground="#9997AA" FontSize="8" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <StackPanel x:Name="PageContent" ClipToBounds="False"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>