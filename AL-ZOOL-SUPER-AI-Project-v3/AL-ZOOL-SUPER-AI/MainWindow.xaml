<Window x:Class="ALZOOOOL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AL-ZOOL SUPER AI" Height="920" Width="1540"
        MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0B100D" Foreground="#F4F1E8"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Gold" Color="#D8B45A"/>
        <SolidColorBrush x:Key="GoldSoft" Color="#8D7540"/>
        <SolidColorBrush x:Key="Green" Color="#28734D"/>
        <SolidColorBrush x:Key="GreenBright" Color="#3A9665"/>
        <SolidColorBrush x:Key="Canvas" Color="#0B100D"/>
        <SolidColorBrush x:Key="Sidebar" Color="#101A14"/>
        <SolidColorBrush x:Key="Panel" Color="#151F19"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#1B2921"/>
        <SolidColorBrush x:Key="Line" Color="#293B30"/>
        <SolidColorBrush x:Key="Muted" Color="#9BA99F"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F1E8"/>
            <Setter Property="Background" Value="#203B2B"/>
            <Setter Property="BorderBrush" Value="#355B43"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B573C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D8B45A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="17"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" CornerRadius="20"
                BorderBrush="#263B2D" BorderThickness="1" Padding="14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Border Background="#1A2B20" BorderBrush="#69572F" BorderThickness="1"
                            CornerRadius="15" Padding="15" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="AZ" Foreground="{StaticResource Gold}"
                                       FontSize="33" FontWeight="ExtraBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="الــزول" Foreground="#F5F0E4"
                                       FontSize="23" FontWeight="Bold" Margin="0,-3,0,0"/>
                            <TextBlock Text="SUPER AI  /  GOLD SYSTEM" Foreground="#AFC0B2"
                                       FontSize="9" Margin="0,7,0,0"/>
                            <Border Height="1" Background="#40513D" Margin="0,12,0,9"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#D8B45A" Margin="0,0,7,0"/>
                                <TextBlock Text="XAUUSD  •  GOLD" Foreground="#DCCB9C"
                                           FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="القائمة الرئيسية" Foreground="#8D9D91"
                               FontSize="10" FontWeight="Bold" Margin="7,0,0,8"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="2,12,2,2">
                    <Border Background="#17231B" CornerRadius="11" Padding="11">
                        <StackPanel>
                            <TextBlock Text="حالة المنصة" Foreground="#87998D" FontSize="10"/>
                            <TextBlock Text="MT5  •  مراقبة الاتصال" Foreground="#D8B45A"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="AL-ZOOL  |  BUILD 2026" Foreground="#637368"
                               FontSize="9" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Style="{StaticResource NavButton}" Content="◈   الرئيسية" Tag="الرئيسية" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="✧   عقل الذكاء الاصطناعي" Tag="عقل الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌁   تحليل السوق" Tag="تحليل السوق" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▤   مكتبة الاستراتيجيات" Tag="مكتبة الاستراتيجيات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▦   مختبر الاستراتيجيات والتركيبات" Tag="مختبر الاستراتيجيات والتركيبات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◉   قرارات الذكاء الاصطناعي" Tag="قرارات الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⇄   الصفقات المفتوحة" Tag="الصفقات المفتوحة" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⬡   إدارة المخاطر" Tag="إدارة المخاطر" Click="Navigate_Click"/>
                        <TextBlock Text="إدارة النظام" Foreground="#8D9D91" FontSize="10"
                                   FontWeight="Bold" Margin="7,15,0,7"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙   الإعدادات الثابتة" Tag="الإعدادات الثابتة" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="↗   اللوت والتعزيز والتبريد" Tag="اللوت والتعزيز والتبريد" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▥   الأداء والإحصائيات" Tag="الأداء والإحصائيات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◌   ذاكرة الذكاء الاصطناعي" Tag="ذاكرة الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌘   مراقبة النظام والاتصال" Tag="مراقبة النظام والاتصال" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚠   مركز الطوارئ" Tag="مركز الطوارئ" Click="Navigate_Click"/>
                        <TextBlock Text="أدوات متقدمة" Foreground="#8D9D91" FontSize="10"
                                   FontWeight="Bold" Margin="7,15,0,7"/>
                        <Button Style="{StaticResource NavButton}" Content="◷   الأخبار الاقتصادية" Tag="الأخبار الاقتصادية" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="☷   سجل التداول" Tag="سجل التداول" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="♧   التنبيهات" Tag="التنبيهات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="✦   إعدادات الذكاء الاصطناعي" Tag="إعدادات الذكاء الاصطناعي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◇   ماذا لو؟ محاكاة السوق" Tag="ماذا لو؟ محاكاة السوق" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌖   خريطة السيولة" Tag="خريطة السيولة" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌁   توقع حركة الذهب" Tag="توقع حركة الذهب" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⇆   مقارنة الصفقات" Tag="مقارنة الصفقات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="♜   منافسة الاستراتيجيات" Tag="منافسة الاستراتيجيات" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▧   سجل التداول التحليلي" Tag="سجل التداول التحليلي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◖   المساعد الصوتي العربي" Tag="المساعد الصوتي العربي" Click="Navigate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="☷   مركز التحكم الرئيسي" Tag="مركز التحكم الرئيسي" Click="Navigate_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Column="1" Margin="18,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,2,2,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="الرئيسية" FontSize="27"
                               FontWeight="Bold" Foreground="#F4F0E5"/>
                    <TextBlock x:Name="PageDescription" Text="مركز قيادة الذهب — رؤية واضحة وتحكم كامل"
                               Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#17231B" BorderBrush="#314738" BorderThickness="1"
                            CornerRadius="10" Padding="13,10" Margin="0,0,9,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#D17B55" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnectionStatus" Text="غير متصل"
                                       Foreground="#E5B18E" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ConnectButton" Content="ربط / تحديث MT5"
                            Click="ConnectButton_Click" Background="#D8B45A"
                            Foreground="#182017" BorderBrush="#D8B45A"
                            Padding="18,12" MinWidth="150"/>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,9,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="حالة التداول" Style="{StaticResource SmallLabel}"/>
                            <TextBlock x:Name="TradingStatus" Text="متوقف" FontSize="25"
                                       FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,8,0,0"/>
                            <TextBlock Text="حالة محرك التداول" Foreground="#74877A" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#26382B" CornerRadius="12"
                                Width="40" Height="40" VerticalAlignment="Top">
                            <TextBlock Text="Ⅱ" Foreground="{StaticResource Gold}" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,9,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="الأداة النشطة" Style="{StaticResource SmallLabel}"/>
                            <TextBlock Text="XAUUSD" FontSize="25" FontWeight="Bold"
                                       Foreground="#E9E4D8" Margin="0,8,0,0"/>
                            <TextBlock Text="GOLD  /  الذهب" Foreground="#74877A" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#26382B" CornerRadius="12"
                                Width="40" Height="40" VerticalAlignment="Top">
                            <TextBlock Text="◆" Foreground="{StaticResource Gold}" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="وضع النظام" Style="{StaticResource SmallLabel}"/>
                            <TextBlock Text="مراقبة وتحليل" FontSize="22" FontWeight="Bold"
                                       Foreground="#A9D2B0" Margin="0,8,0,0"/>
                            <TextBlock Text="قراءة بيانات منصة MT5" Foreground="#74877A" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#26382B" CornerRadius="12"
                                Width="40" Height="40" VerticalAlignment="Top">
                            <TextBlock Text="◉" Foreground="#A9D2B0" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="#17251B" BorderBrush="#65542F"
                    BorderThickness="1" CornerRadius="16" Padding="17" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#2A3B2B" CornerRadius="5" Padding="7,3" Margin="0,0,8,0">
                                <TextBlock Text="CONTROL" Foreground="{StaticResource Gold}"
                                           FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="مركز التحكم بالتداول" Foreground="#F0E8D4"
                                       FontSize="17" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="التشغيل الآلي غير متاح حالياً — لن يتم إرسال أوامر قبل اكتمال الربط واختبار الحماية."
                                   Foreground="#B9B29A" FontSize="11" Margin="0,7,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="15,0,0,0">
                        <Button x:Name="StartButton" Content="▶   تشغيل التداول الآلي"
                                Click="StartButton_Click" Width="190" Height="45"
                                Background="#28734D" BorderBrush="#469568" Margin="0,0,8,0"/>
                        <Button x:Name="StopButton" Content="■   إيقاف التداول"
                                Click="StopButton_Click" Width="155" Height="45"
                                Background="#713E37" BorderBrush="#A45C50"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="17"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="مساحة العمل" Foreground="#F0E8D4"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="المعلومات والنتائج الخاصة بالقسم المختار"
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#202D24" CornerRadius="8" Padding="10,6"
                                VerticalAlignment="Center">
                            <TextBlock Text="LIVE WORKSPACE" Foreground="#A9B99E"
                                       FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="#101912" BorderBrush="#2B4433" BorderThickness="1"
                                    CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <TextBlock x:Name="SectionInfo" Text="بانتظار بيانات MT5..."
                                           FontSize="14" TextWrapping="Wrap" Foreground="#EDE9DF"
                                           LineHeight="25"/>
                            </Border>
                            <TextBlock Text="تفاصيل القسم" Foreground="{StaticResource Gold}"
                                       FontSize="15" FontWeight="Bold" Margin="2,0,0,10"/>
                            <StackPanel x:Name="PageContent"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>